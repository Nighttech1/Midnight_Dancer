<?xml version="1.0" encoding="utf-8"?>
<!--
  C-59: full-bleed video edge-to-edge.
  Skip floats OVER video — TextView + drawable only (no Material Button insets/shelf).
  Never wrap Skip in a LinearLayout / painted bar.
  No elevation on Skip — ambient shadow reads as a black shelf on OLED.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_boot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:padding="0dp">

    <androidx.media3.ui.PlayerView
        android:id="@+id/splash_boot_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="false"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:keep_content_on_player_reset="true" />

    <TextView
        android:id="@+id/splash_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="188dp"
        android:elevation="0dp"
        android:fontFamily="@font/noto_serif_regular"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/splash_loading_voice"
        android:textColor="#E0FFFFFF"
        android:textSize="12sp" />

    <!--
      TextView CTA — not Material Button (default insetTop/Bottom paint a black shelf
      against OledTrueBlack Surface when video doesn't cover those inset bands).
      elevation=0: Material/View ambient shadow under a full-width CTA looks like a shelf.
    -->
    <TextView
        android:id="@+id/splash_skip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/splash_skip_button"
        android:clickable="true"
        android:contentDescription="@string/splash_skip_cd"
        android:elevation="0dp"
        android:focusable="true"
        android:fontFamily="@font/noto_serif_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:stateListAnimator="@null"
        android:text="@string/splash_skip"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
